rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /parkir/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /pengumuman/{id} {
      allow read: if true;
      allow create, update, delete: if admin();

      match /balasan/{replyId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.isi is string
          && request.resource.data.isi.size() > 0
          && request.resource.data.isi.size() <= 1000
          && request.resource.data.pengirim is string
          && request.resource.data.pengirim.size() <= 30
          && request.resource.data.waktu is int;
        allow update, delete: if admin();
      }
    }

    match /visitors/{id} {
      allow read: if admin();
      allow create: if request.resource.data.device is string
        && request.resource.data.userAgent is string
        && request.resource.data.page == "parkir-app"
        && request.resource.data.time is int;
      allow update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
